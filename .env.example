# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Step-by-step instructions: see SETUP-GOOGLE-CLOUD.md

# Which map to render.
#   auto   (default) Google Maps if a key is set below, otherwise OpenStreetMap
#   google force Google Maps — the real map this app ships with
#   osm    force OpenStreetMap + Leaflet — keyless, for testing
MAP_PROVIDER=auto

# From Google Cloud Console → APIs & Services → Credentials.
# Leave empty to test on OpenStreetMap; fill in to switch to Google Maps.
GOOGLE_MAPS_API_KEY=

# Optional. A Map ID enables custom map styling. 'DEMO_MAP_ID' is Google's
# development-only default and works without any setup.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Optional. Port the server listens on.
PORT=3000
